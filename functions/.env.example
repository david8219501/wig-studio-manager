# דוגמה בלבד - אל תשימי כאן ערכים אמיתיים ואל תוסיפי קובץ .env ל-git.
#
# GOOGLE_CLIENT_ID ו-GOOGLE_CLIENT_SECRET לא נטענים מקובץ .env בפועל -
# הם מנוהלים כ-Secrets דרך Secret Manager של Firebase (ראו README.md
# באותה תיקייה, סעיף "הגדרת ה-Secrets לפני פריסה"), כדי שהערכים לא
# יישמרו בקוד או ב-git בכלל. הקובץ הזה קיים רק לתיעוד אילו משתני סביבה
# הפונקציות מצפות להם.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
