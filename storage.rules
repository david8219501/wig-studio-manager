rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // כל עסק כותב/קורא רק ללוגו שלו - logos/{businessId}/*.
    // קריאה פתוחה יותר (גם למי שלא מחוברת) כי הלוגו מוצג בסיידבר/favicon
    // בלי דרישת אימות בכל מקום שהוא מוצג; כתיבה רק ל-uid התואם.
    match /logos/{businessId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == businessId;
    }
    // כל השאר חסום כברירת מחדל.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
